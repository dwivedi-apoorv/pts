# Copy to .env.local and fill in. Never commit real values.

# Supabase: Project settings, API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Branding and URLs
NEXT_PUBLIC_APP_NAME=DigiRocket Technologies
NEXT_PUBLIC_SITE_URL=

# "true" shows "This email is not registered"; "false" shows a generic message
REVEAL_UNREGISTERED=true

# Resend, for the sign-in code emails (server only)
RESEND_API_KEY=
# Sender on your verified Resend domain, e.g. DigiRocket Technologies <learn@your-domain.com>
EMAIL_FROM=
